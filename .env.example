# ===========================================
# STAFF - Environment Variables
# Netlify: Site Settings → Environment Variables
# ===========================================

# SUPABASE - Server-side / Netlify Functions
SUPABASE_URL=https://mkwkljnfaqszvcjzhajn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_SERVICE_ROLE_KEY_AQUI
# Alternativa aceita pelo backend:
# SUPABASE_SECRET_KEY=COLE_SUA_SECRET_KEY_AQUI

# SUPABASE - Client-side / Frontend Vite
VITE_SUPABASE_URL=https://mkwkljnfaqszvcjzhajn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_SUA_PUBLISHABLE_KEY_AQUI
# Compatibilidade, se o projeto ainda usar anon key:
# VITE_SUPABASE_ANON_KEY=COLE_SUA_ANON_KEY_AQUI

# OPENAI - somente servidor
OPENAI_API_KEY=COLE_SUA_OPENAI_API_KEY_AQUI
OPENAI_STUDY_MODEL=gpt-5-mini
OPENAI_DOCUMENT_MODEL=gpt-5-mini

# SMART INBOX - provider-agnostic
# internal_ai | mock | docstruct
STAFF_DOCUMENT_PROVIDER=internal_ai

# BLOQUEADO por padrão. Só defina true após revisão de privacidade/contratos
# do provedor; o usuário ainda precisará consentir explicitamente no app.
STAFF_ALLOW_SENSITIVE_EXTERNAL_PROCESSING=false

# Opcional: adapter de fornecedor externo compatível com staff_document_v1
DOCSTRUCT_API_URL=
DOCSTRUCT_API_KEY=

# TWILIO (legado/integrações opcionais)
TWILIO_ACCOUNT_SID=COLE_SUA_TWILIO_SID_AQUI
TWILIO_AUTH_TOKEN=COLE_SUA_AUTH_TOKEN_AQUI
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

NODE_VERSION=22
